+void Opendp::reportEvolvePlacementMetrics(const char* stage_name) const
+{
+  if (stage_name == nullptr || block_ == nullptr || network_ == nullptr) {
+    return;
+  }
+
+  const std::string prefix
+      = fmt::format("dpl_evolve__stage_{}__dp__", stage_name);
+
+  int cell_count = 0;
+  int movable_count = 0;
+  int placed_count = 0;
+  int moved_count = 0;
+  int64_t displacement_sum = 0;
+  int64_t displacement_max = 0;
+  for (const auto& cell : network_->getNodes()) {
+    if (cell->getType() != Node::CELL) {
+      continue;
+    }
+    ++cell_count;
+    if (cell->isFixed()) {
+      continue;
+    }
+
+    ++movable_count;
+    if (isPlaced(cell.get())) {
+      ++placed_count;
+    }
+
+    const int displacement = disp(cell.get());
+    displacement_sum += displacement;
+    displacement_max = std::max<int64_t>(displacement_max, displacement);
+    if (displacement > 0) {
+      ++moved_count;
+    }
+  }
+
+  const double avg_displacement
+      = movable_count == 0
+            ? 0.0
+            : static_cast<double>(displacement_sum)
+                  / static_cast<double>(movable_count);
+
+  logger_->metric(prefix + "cell_count", cell_count);
+  logger_->metric(prefix + "movable_count", movable_count);
+  logger_->metric(prefix + "placed_count", placed_count);
+  logger_->metric(prefix + "moved_count", moved_count);
+  logger_->metric(prefix + "total_displacement_micron",
