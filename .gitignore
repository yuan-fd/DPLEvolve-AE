# DPLEvolve Artifact Evaluation — .gitignore
# Generated artifacts, build outputs, and machine-local state.

# Python
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/

# Virtual environments
.venv/
venv/
*.venv/

# Build outputs
build/
*.o
*.so
*.a

# Large generated EDA databases and signoff products. Do not blanket-ignore
# Verilog, SDC, DEF, LEF, or Liberty files; they may be intentional inputs.
*.odb
*.spef
*.sdf
*.gds
*.oas

# Generated artifact outputs. Keep the empty output directories in Git.
artifacts/*/output/*
artifacts/*/selected-programs/output/*
!artifacts/*/output/.gitkeep
!artifacts/*/selected-programs/output/.gitkeep

# Local preservation area; never include it in Git or release archives.
extras/unsupported/

# Environment lock (machine-local)
env/environment.local.sh
**/environment.local.sh
**/env.local.sh

# API keys, tokens, secrets
*.key
*.token
.env
.env.*
secrets/
credentials/

# IDE and editor
.idea/
.vscode/
*.swp
*.swo
*~

# macOS
.DS_Store

# Provenance checksums (generated per machine)
provenance/current-machine.json

# Temporary files
tmp/
temp/
*.tmp
*.log

# Zenodo export archive
*.zip
*.tar.gz
*.tar.xz
DPLEvolve-AE-*.zip

# ── Bundled dpl_evolve_agent gitignore patterns ──────────────────────────
# These apply to the bundled framework under src/.
src/dpl_evolve_agent/env.sh
src/dpl_evolve_agent/.dpl_evolve_state/
src/dpl_evolve_agent/.runtime_aliases/
src/dpl_evolve_agent/.venv_raytune/
src/dpl_evolve_agent/local_backups/
src/dpl_evolve_agent/family_ideas/
src/dpl_evolve_agent/variant_ideas/
src/dpl_evolve_agent/checkpoints/
src/dpl_evolve_agent/knowledge/packets/current_run_packet.md
src/dpl_evolve_agent/knowledge/packets/current_run_packet.json
src/dpl_evolve_agent/knowledge/reference/papers/pdf_cache/
# Large/external exact paper inputs are distributed separately.
paper-data/
