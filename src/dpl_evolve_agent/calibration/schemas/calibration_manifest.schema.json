{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://reviewdse.local/schemas/calibration_manifest.schema.json",
  "title": "ReviewDSE Level 1 Calibration Manifest",
  "type": "object",
  "required": [
    "schema_version",
    "calibration_id",
    "created_at",
    "case_set",
    "protected_evaluator",
    "outputs"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "calibration_id": {
      "type": "string",
      "minLength": 1
    },
    "created_at": {
      "type": "string",
      "description": "ISO-8601 timestamp."
    },
    "case_set": {
      "type": "string",
      "minLength": 1
    },
    "target_disjointness_note": {
      "type": "string"
    },
    "protected_evaluator": {
      "type": "object",
      "required": [
        "orfs_anchor",
        "openroad_anchor",
        "canonical_lines",
        "metric_contract"
      ],
      "properties": {
        "orfs_anchor": {
          "type": "string"
        },
        "openroad_anchor": {
          "type": "string"
        },
        "canonical_lines": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "metric_contract": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "source_starts": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "evidence_records": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "outputs": {
      "type": "object",
      "required": [
        "state_root"
      ],
      "properties": {
        "state_root": {
          "type": "string"
        },
        "summary_report": {
          "type": "string"
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}
