+  auto refresh_hpwl_cache_for_cell = [&](const int item_idx,
+                                         int64_t* cache_cells,
+                                         int64_t* cache_nets,
+                                         int64_t* cache_pin_offsets,
+                                         int64_t* cache_anchor_cells) {
+    if (item_idx < 0 || item_idx >= static_cast<int>(cells.size())) {
+      return;
+    }
+    LegalmCachedHpwlCell cell_cache;
+    const LegalmPlaceCell& item = cells[item_idx];
+    Node* moved = item.cell;
+    if (moved == nullptr || moved->getNumPins() == 0
+        || moved->getNumPins() > kAffectedHpwlCellPinLimit
+        || site_width.v <= 0) {
+      hpwl_cache[item_idx] = std::move(cell_cache);
+      return;
+    }
+
+    std::unordered_map<const Edge*, int> seen_edges;
+    int64_t anchor_sum = 0;
+    int64_t anchor_row_sum = 0;
+    int anchor_count = 0;
+    for (const Pin* moved_pin : moved->getPins()) {
+      const Edge* edge
+          = moved_pin == nullptr ? nullptr : moved_pin->getEdge();
+      if (edge == nullptr || seen_edges.contains(edge)) {
+        continue;
+      }
+      seen_edges[edge] = static_cast<int>(seen_edges.size());
+      const int pin_count = edge->getNumPins();
+      if (pin_count <= 1 || pin_count > kAffectedHpwlFanoutLimit) {
+        continue;
+      }
