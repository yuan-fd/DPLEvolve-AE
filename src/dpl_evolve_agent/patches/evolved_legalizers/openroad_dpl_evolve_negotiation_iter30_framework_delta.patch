+// ===========================================================================
+// buildAffectedNetCache - source-quality HPWL boxes for bounded scoring.
+// ===========================================================================
+
+void NegotiationLegalizer::refreshAffectedNetCacheForCell(const int cell_idx,
+                                                         const bool count_dynamic)
+{
+  if (cell_idx < 0 || cell_idx >= static_cast<int>(cells_.size())
+      || cell_idx >= static_cast<int>(affected_hpwl_cache_.size())) {
+    return;
+  }
+  affected_hpwl_cache_[cell_idx] = AffectedHpwlCellCache{};
+  if (network_ == nullptr || site_width_ <= 0) {
+    return;
+  }
+
+  const NegCell& cell = cells_[cell_idx];
+  Node* moved = network_->getNode(cell.db_inst);
+  if (moved == nullptr || moved->getNumPins() == 0
+      || moved->getNumPins() > kNegAffectedHpwlCellPinLimit) {
+    return;
+  }
+
+  auto merge_point = [](CachedAffectedNetBox& box,
+                        bool& initialized,
+                        const int x,
+                        const int y) {
+    if (!initialized) {
+      box.x_min = box.x_max = x;
+      box.y_min = box.y_max = y;
+      initialized = true;
+      return;
+    }
+    box.x_min = std::min(box.x_min, x);
+    box.y_min = std::min(box.y_min, y);
+    box.x_max = std::max(box.x_max, x);
+    box.y_max = std::max(box.y_max, y);
+  };
+
+  AffectedHpwlCellCache cell_cache;
+  std::unordered_set<const Edge*> seen_edges;
+  int64_t anchor_sum = 0;
+  int anchor_count = 0;
+  for (const Pin* moved_pin : moved->getPins()) {
+    const Edge* edge = moved_pin == nullptr ? nullptr : moved_pin->getEdge();
+    if (edge == nullptr || !seen_edges.insert(edge).second) {
+      continue;
+    }
+    const int pin_count = edge->getNumPins();
+    if (pin_count <= 1 || pin_count > kNegAffectedHpwlFanoutLimit) {
+      continue;
+    }
+
+    CachedAffectedNetBox net_cache;
+    bool other_box_initialized = false;
+    for (const Pin* pin : edge->getPins()) {
+      const Node* node = pin == nullptr ? nullptr : pin->getNode();
+      if (node == nullptr) {
+        continue;
+      }
+      if (node == moved) {
+        net_cache.moved_pin_offsets.push_back(
+            {pin->getOffsetX().v, pin->getOffsetY().v});
+        continue;
+      }
+      merge_point(net_cache,
+                  other_box_initialized,
+                  node->getCenterX().v + pin->getOffsetX().v,
+                  node->getCenterY().v + pin->getOffsetY().v);
+    }
+    if (!other_box_initialized || net_cache.moved_pin_offsets.empty()) {
+      continue;
+    }
+    anchor_sum += (static_cast<int64_t>(net_cache.x_min)
+                   + static_cast<int64_t>(net_cache.x_max))
+                  / 2;
+    ++anchor_count;
+    cell_cache.nets.push_back(std::move(net_cache));
+  }
+
+  const int quality_den
+      = std::max(1, std::min(moved->getNumPins(),
+                             kNegAffectedHpwlCellPinLimit));
+  cell_cache.source_quality
+      = std::clamp(static_cast<double>(cell_cache.nets.size())
+                       / static_cast<double>(quality_den),
+                   0.0,
+                   1.0);
+  if (anchor_count > 0) {
+    const int width_dbu = std::max(1, moved->getWidth().v);
+    const int anchor_x = static_cast<int>(anchor_sum / anchor_count);
+    cell_cache.anchor_site = std::clamp(
+        static_cast<int>(std::llround(
+            static_cast<double>(anchor_x - width_dbu / 2)
+            / static_cast<double>(site_width_))),
+        0,
+        std::max(0, grid_w_ - cell.width));
+  }
+  affected_hpwl_cache_[cell_idx] = std::move(cell_cache);
+  if (count_dynamic) {
+    ++affected_hpwl_dynamic_refreshes_;
+  }
+}
+
+void NegotiationLegalizer::refreshAffectedNetCacheNeighborhood(
+    const int cell_idx)
+{
+  if (network_ == nullptr || cell_idx < 0
+      || cell_idx >= static_cast<int>(cells_.size())) {
+    return;
+  }
+  Node* moved = network_->getNode(cells_[cell_idx].db_inst);
+  if (moved == nullptr || moved->getNumPins() == 0
+      || moved->getNumPins() > kNegAffectedHpwlCellPinLimit) {
+    refreshAffectedNetCacheForCell(cell_idx, true);
+    return;
+  }
+
+  std::unordered_set<int> touched;
+  touched.insert(cell_idx);
+  std::unordered_set<const Edge*> seen_edges;
+  for (const Pin* moved_pin : moved->getPins()) {
+    const Edge* edge = moved_pin == nullptr ? nullptr : moved_pin->getEdge();
+    if (edge == nullptr || !seen_edges.insert(edge).second) {
+      continue;
+    }
+    const int pin_count = edge->getNumPins();
+    if (pin_count <= 1 || pin_count > kNegAffectedHpwlFanoutLimit) {
+      continue;
+    }
+    for (const Pin* pin : edge->getPins()) {
+      const Node* node = pin == nullptr ? nullptr : pin->getNode();
+      const odb::dbInst* inst = node == nullptr ? nullptr : node->getDbInst();
+      if (inst == nullptr) {
+        continue;
+      }
+      auto it = inst_cell_index_.find(const_cast<odb::dbInst*>(inst));
+      if (it != inst_cell_index_.end()) {
+        touched.insert(it->second);
+      }
+    }
+  }
+
+  for (const int idx : touched) {
+    refreshAffectedNetCacheForCell(idx, true);
+  }
+  affected_hpwl_neighbor_refreshes_ += static_cast<int64_t>(touched.size());
+}
+
+void NegotiationLegalizer::buildAffectedNetCache()
+{
+  affected_hpwl_cache_.clear();
+  affected_hpwl_cache_.resize(cells_.size());
+  affected_hpwl_dynamic_refreshes_ = 0;
+  affected_hpwl_neighbor_refreshes_ = 0;
+  if (network_ == nullptr || site_width_ <= 0) {
+    return;
+  }
+  for (int cell_idx = 0; cell_idx < static_cast<int>(cells_.size());
+       ++cell_idx) {
+    refreshAffectedNetCacheForCell(cell_idx, false);
+  }
+}
+
+// ===========================================================================
+// affectedNetHpwlDeltaSites - bounded local HPWL proxy for one candidate move.
+//   Only nets incident to the moved cell are touched, high-fanout nets are
+//   skipped, and deltas are clipped so this remains a tie-breaker behind
+//   legality/history pressure.
+// ===========================================================================
+
+double NegotiationLegalizer::affectedNetHpwlDeltaSites(const int cell_idx,
+                                                       const int x,
+                                                       const int y,
+                                                       int* net_count) const
+{
+  if (net_count != nullptr) {
+    *net_count = 0;
+  }
+  if (cell_idx < 0 || cell_idx >= static_cast<int>(cells_.size())
+      || site_width_ <= 0
+      || cell_idx >= static_cast<int>(affected_hpwl_cache_.size())) {
+    return 0.0;
+  }
+
+  const NegCell& moved_cell = cells_[cell_idx];
+  const AffectedHpwlCellCache& cache = affected_hpwl_cache_[cell_idx];
+  if (cache.nets.empty()) {
+    return 0.0;
+  }
+
+  Node* moved = network_ != nullptr ? network_->getNode(moved_cell.db_inst)
+                                    : nullptr;
+  const int width_dbu = moved != nullptr ? moved->getWidth().v
+                                         : moved_cell.width * site_width_;
+  const int height_dbu = moved != nullptr ? moved->getHeight().v
+                                          : moved_cell.height * row_height_;
+  const int old_moved_x = moved_cell.x * site_width_ + width_dbu / 2;
+  const int old_moved_y
+      = opendp_->grid_->gridYToDbu(GridY{moved_cell.y}).v + height_dbu / 2;
+  const int new_moved_x = x * site_width_ + width_dbu / 2;
+  const int new_moved_y
+      = opendp_->grid_->gridYToDbu(GridY{y}).v + height_dbu / 2;
+
+  auto merge_point = [](int& x_min,
+                        int& y_min,
+                        int& x_max,
+                        int& y_max,
+                        const int px,
+                        const int py) {
+    x_min = std::min(x_min, px);
+    y_min = std::min(y_min, py);
+    x_max = std::max(x_max, px);
+    y_max = std::max(y_max, py);
+  };
+
+  int64_t old_hpwl = 0;
+  int64_t new_hpwl = 0;
+  for (const CachedAffectedNetBox& net : cache.nets) {
+    int old_x_min = net.x_min;
+    int old_y_min = net.y_min;
+    int old_x_max = net.x_max;
+    int old_y_max = net.y_max;
+    int new_x_min = net.x_min;
