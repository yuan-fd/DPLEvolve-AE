+      net.y_min = net.y_max = y;
+      initialized = true;
+      return;
+    }
+    net.x_min = std::min(net.x_min, x);
+    net.y_min = std::min(net.y_min, y);
+    net.x_max = std::max(net.x_max, x);
+    net.y_max = std::max(net.y_max, y);
