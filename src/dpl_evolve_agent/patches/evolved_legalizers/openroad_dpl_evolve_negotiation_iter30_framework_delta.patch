diff --git a/src/dpl_evolve/src/EvolveNegotiationRepair.cpp b/src/dpl_evolve/src/EvolveNegotiationRepair.cpp
index bbd7c36..0b39337 100644
--- a/src/dpl_evolve/src/EvolveNegotiationRepair.cpp
+++ b/src/dpl_evolve/src/EvolveNegotiationRepair.cpp
@@ -6,10 +6,9 @@
 
 namespace dpl_evolve {
 
-// Explicit policy-assisted repair after the paper-style LEGALM path.  This is
-// not a LEGALM paper stage.  LEGALM writes Opendp Node positions first, so sync
-// them to ODB before the negotiation legalizer imports its compact DB-backed
-// state.
+// Negotiation-primary legalization for the evolved route.  Earlier stages may
+// seed guided Opendp Node positions, so sync them to ODB before the negotiation
+// legalizer imports its compact DB-backed state.
 bool Opendp::runEvolveNegotiationRepair(const bool run_abacus)
 {
   updateDbInstLocations();
@@ -22,8 +21,11 @@ bool Opendp::runEvolveNegotiationRepair(const bool run_abacus)
 
   logger_->info(DPL,
                 1215,
-                "DPL-Evolve repair stage: NegotiationLegalizer with Abacus {}.",
+                "DPL-Evolve primary stage: NegotiationLegalizer with Abacus "
+                "{}.",
                 run_abacus ? "enabled" : "disabled");
+  logger_->metric("dpl_evolve__negotiation_primary__run_abacus",
+                  run_abacus ? 1 : 0);
 
   NegotiationLegalizer negotiation(this,
                                    db_,
@@ -38,18 +40,18 @@ bool Opendp::runEvolveNegotiationRepair(const bool run_abacus)
                                           : "negotiation_repair");
 
   const int violations = negotiation.numViolations();
-  logger_->metric("dpl_evolve__repair__negotiation_violations", violations);
+  logger_->metric("dpl_evolve__negotiation_primary__final_violations",
+                  violations);
   if (violations > 0) {
     logger_->warn(DPL,
                   1216,
-                  "DPL-Evolve negotiation repair left {} placement violations.",
+                  "DPL-Evolve primary negotiation left {} placement "
+                  "violations.",
                   violations);
     return false;
   }
-  // LEGALM may have recorded cells that its interval legalizer could not place.
-  // Negotiation repair has just checked the final state, so stale LEGALM
-  // failure records must not make the top-level DPL error path report a clean
-  // repair as failed.
+  // Guidance/frontier stages may have stale failure records; the primary
+  // negotiation legalizer has just checked the final state.
   placement_failures_.clear();
   return true;
 }
