+  auto affected_hpwl_delta_sites = [&](const int item_idx,
+                                       const int from_row,
+                                       const int from_site,
+                                       const int to_row,
+                                       const int to_site,
+                                       int64_t* net_evals) {
+    if (item_idx < 0 || item_idx >= static_cast<int>(hpwl_cache.size())) {
+      return 0.0;
+    }
+    const LegalmPlaceCell& item = cells[item_idx];
+    Node* moved = item.cell;
+    const LegalmCachedHpwlCell& cell_cache = hpwl_cache[item_idx];
+    if (moved == nullptr || cell_cache.nets.empty() || site_width.v <= 0) {
+      return 0.0;
+    }
+
+    const int old_moved_x = cell_center_x(item, from_site);
+    const int old_moved_y = cell_center_y(item, from_row);
+    const int new_moved_x = cell_center_x(item, to_site);
+    const int new_moved_y = cell_center_y(item, to_row);
+
+    int64_t old_hpwl = 0;
+    int64_t new_hpwl = 0;
+    auto merge_point = [](int& x_min,
+                          int& y_min,
+                          int& x_max,
+                          int& y_max,
+                          const int x,
+                          const int y) {
+      x_min = std::min(x_min, x);
+      y_min = std::min(y_min, y);
+      x_max = std::max(x_max, x);
+      y_max = std::max(y_max, y);
+    };
+
+    for (const LegalmCachedHpwlNet& net_cache : cell_cache.nets) {
+      int old_x_min = net_cache.x_min;
+      int old_y_min = net_cache.y_min;
+      int old_x_max = net_cache.x_max;
+      int old_y_max = net_cache.y_max;
+      int new_x_min = net_cache.x_min;
+      int new_y_min = net_cache.y_min;
+      int new_x_max = net_cache.x_max;
+      int new_y_max = net_cache.y_max;
+      for (const auto& [offset_x, offset_y] : net_cache.moved_pin_offsets) {
+        merge_point(old_x_min,
+                    old_y_min,
+                    old_x_max,
+                    old_y_max,
+                    old_moved_x + offset_x,
+                    old_moved_y + offset_y);
+        merge_point(new_x_min,
+                    new_y_min,
+                    new_x_max,
+                    new_y_max,
+                    new_moved_x + offset_x,
+                    new_moved_y + offset_y);
+      }
+      old_hpwl += (old_x_max - old_x_min) + (old_y_max - old_y_min);
+      new_hpwl += (new_x_max - new_x_min) + (new_y_max - new_y_min);
+    }
