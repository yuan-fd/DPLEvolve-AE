+        y_min = std::min(y_min, y);
+        x_max = std::max(x_max, x);
+        y_max = std::max(y_max, y);
+      };
+      bool new_initialized = false;
+      for (const Pin* pin : edge->getPins()) {
+        const Node* node = pin == nullptr ? nullptr : pin->getNode();
+        if (node == nullptr) {
+          continue;
+        }
+        int old_center_x = node->getCenterX().v;
+        int old_center_y = node->getCenterY().v;
+        int new_center_x = old_center_x;
+        int new_center_y = old_center_y;
+        if (node == first_node) {
