+
+#pragma once
+
+#include <string>
+#include <vector>
+
+#include "detailed_generator.h"
+
+namespace odb {
+class Rect;
+}
+namespace dpl_evolve {
+class Edge;
+class Architecture;
+class DetailedMgr;
+class Network;
+
+namespace legacy {
+using ::dpl_evolve::Architecture;
+using ::dpl_evolve::DetailedMgr;
+using ::dpl_evolve::Edge;
