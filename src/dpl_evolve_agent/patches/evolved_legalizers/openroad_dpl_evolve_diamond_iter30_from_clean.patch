+  {
+    DrcMode_NoPenalty = 0,
+    DrcMode_NormalPenalty,
+    DrcMode_Eliminate,
+    DrcMode_Unknown
+  };
+  enum MoveMode
+  {
+    MoveMode_Median = 0,
+    MoveMode_CellDensity1,
+    MoveMode_RandomWindow,
+    MoveMode_Unknown
+  };
+  enum MoveSource
+  {
