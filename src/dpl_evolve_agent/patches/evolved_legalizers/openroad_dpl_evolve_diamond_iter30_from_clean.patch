+
+class DetailedOrient
+{
+ public:
+  DetailedOrient(Architecture* arch, Network* network);
+
+  void run(DetailedMgr* mgrPtr, const std::string& command);
+  void run(DetailedMgr* mgrPtr, std::vector<std::string>& args);
+
