+        if (std::find(x_targets.begin(), x_targets.end(), target_x)
+            == x_targets.end()) {
+          x_targets.push_back(target_x);
+        }
+      };
+      auto pushUniqueY = [&](const DbuY target_y) {
+        if (std::find(y_targets.begin(), y_targets.end(), target_y)
+            == y_targets.end()) {
+          y_targets.push_back(target_y);
+        }
+      };
