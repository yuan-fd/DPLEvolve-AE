+  int dir_{Dir_INOUT};
+  // Layer.
+  int pinLayer_{0};
+  // Node and edge for pin.
+  Node* node_{nullptr};
+  Edge* edge_{nullptr};
+  // Offsets from cell center.
+  DbuX offsetX_{0};
+  DbuY offsetY_{0};
+};
+
+}  // namespace dpl_evolve
