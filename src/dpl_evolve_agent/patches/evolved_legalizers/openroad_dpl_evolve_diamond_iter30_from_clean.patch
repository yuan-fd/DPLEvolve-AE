+
+void Opendp::detailedPlacement(const int max_displacement_x,
+                               const int max_displacement_y,
+                               const std::string& report_file_name,
+                               bool incremental,
+                               const bool use_negotiation,
+                               const bool run_abacus,
+                               const int threads,
+                               const int legalm_iterations,
+                               const int legalm_candidate_vertical_radius,
+                               const int legalm_candidate_horizontal_steps,
+                               const int legalm_stage3_partition_schemes,
+                               const int legalm_stage3_rounds_per_scheme)
+{
+  incremental_ = incremental;
+  // Keep repair policy local to this command invocation.  The paper-faithful
+  // LEGALM path must not inherit a previous run's policy-assisted repair mode.
+  use_negotiation_ = use_negotiation || run_abacus;
+  run_abacus_ = run_abacus;
+  importDb();
+  adjustNodesOrient();
+  if (!incremental_) {
+    for (const auto& node : network_->getNodes()) {
+      if (node->getType() == Node::CELL && !node->isFixed()) {
+        node->setPlaced(false);
+      }
+    }
+  }
+
+  if (have_fillers_) {
+    logger_->warn(DPL, 37, "Use remove_fillers before detailed placement.");
+  }
+
+  {
+    const int64_t core_area
+        = static_cast<int64_t>(core_.dx()) * static_cast<int64_t>(core_.dy());
+    int64_t inst_area = 0;
+    for (const auto& node : network_->getNodes()) {
+      if (node->getType() == Node::CELL) {
+        inst_area += static_cast<int64_t>(node->getWidth().v)
+                     * static_cast<int64_t>(node->getHeight().v);
+      }
+    }
+    const double utilization = core_area > 0
+                                   ? (static_cast<double>(inst_area)
+                                      / static_cast<double>(core_area))
+                                         * 100.0
+                                   : 0.0;
+    logger_->info(DPL,
+                  6,
+                  "Core area: {:.2f} um^2, Instances area: {:.2f} um^2, "
+                  "Utilization: {:.1f}%",
+                  block_->dbuAreaToMicrons(core_area),
+                  block_->dbuAreaToMicrons(inst_area),
+                  utilization);
+    logger_->metric("utilizatin__before__dpl", utilization);
+    if (utilization > 100.0) {
+      logger_->error(
+          DPL, 38, "Utilization greater than 100%, impossible to legalize");
+    }
+  }
+
+  odb::WireLengthEvaluator eval(block_);
+  hpwl_before_ = eval.hpwl();
+
+  if (max_displacement_x == 0 || max_displacement_y == 0) {
+    max_displacement_x_ = 500;
+    max_displacement_y_ = 100;
+  } else {
+    max_displacement_x_ = max_displacement_x;
+    max_displacement_y_ = max_displacement_y;
+  }
+
+  logger_->info(DPL,
+                5,
+                "Diamond search max displacement: +/- {} sites horizontally, "
+                "+/- {} rows vertically.",
+                max_displacement_x_,
+                max_displacement_y_);
+
+  EvolveContext evolve_context;
+  evolve_context.max_threads = std::max(1, threads);
+  evolve_context.max_displacement_x = max_displacement_x_;
+  evolve_context.max_displacement_y = max_displacement_y_;
+  evolve_context.legalm_iteration_limit = std::max(1, legalm_iterations);
+  evolve_context.legalm_candidate_vertical_radius
+      = std::max(1, legalm_candidate_vertical_radius);
+  evolve_context.legalm_candidate_horizontal_steps
+      = std::max(1, legalm_candidate_horizontal_steps);
+  evolve_context.legalm_stage3_partition_schemes
+      = std::max(1, legalm_stage3_partition_schemes);
+  evolve_context.legalm_stage3_rounds_per_scheme
+      = std::max(1, legalm_stage3_rounds_per_scheme);
+  evolve_context.incremental = incremental_;
+  evolve_context.report_file_name = report_file_name;
+  logger_->info(DPL,
+                1225,
+                "LEGALM parameters: threads {}, T {}, candidate radius {}, "
+                "candidate horizontal steps {}, Stage3 schemes {}, Stage3 "
+                "rounds/scheme {}.",
+                evolve_context.max_threads,
+                evolve_context.legalm_iteration_limit,
+                evolve_context.legalm_candidate_vertical_radius,
+                evolve_context.legalm_candidate_horizontal_steps,
+                evolve_context.legalm_stage3_partition_schemes,
+                evolve_context.legalm_stage3_rounds_per_scheme);
+  logger_->metric("dpl_evolve__legalm__threads",
+                  evolve_context.max_threads);
+  logger_->metric("dpl_evolve__legalm__paper_input_T",
+                  evolve_context.legalm_iteration_limit);
+  logger_->metric("dpl_evolve__legalm__candidate_vertical_radius",
+                  evolve_context.legalm_candidate_vertical_radius);
+  logger_->metric("dpl_evolve__legalm__candidate_horizontal_steps",
+                  evolve_context.legalm_candidate_horizontal_steps);
+  logger_->metric("dpl_evolve__legalm__stage3_partition_schemes",
+                  evolve_context.legalm_stage3_partition_schemes);
+  logger_->metric("dpl_evolve__legalm__stage3_rounds_per_scheme",
+                  evolve_context.legalm_stage3_rounds_per_scheme);
+
+  EvolveHooks evolve_hooks;
+  evolve_hooks.run_student_algorithm = [this](const EvolveContext& context) {
+    return runStudentAlgorithm(context);
+  };
+
+  EvolveLegalizer evolve_legalizer(logger_, std::move(evolve_hooks));
+  evolve_legalizer.run(evolve_context);
+
+  findDisplacementStats();
+  updateDbInstLocations();
+  if (!placement_failures_.empty()) {
+    logger_->info(DPL,
+                  34,
+                  "Detailed placement failed on the following {} instances:",
+                  placement_failures_.size());
+    for (auto cell : placement_failures_) {
+      logger_->info(DPL, 35, " {}", cell->name());
+    }
+
+    saveFailures({}, {}, {}, {}, {}, {}, {}, placement_failures_, {}, {});
+    if (!report_file_name.empty()) {
+      writeJsonReport(report_file_name);
+    }
+    logger_->error(DPL, 36, "Detailed placement failed inside DPL.");
+  }
+}
+
+void Opendp::updateDbInstLocations()
+{
+  for (auto& cell : network_->getNodes()) {
+    if (!cell->isFixed() && cell->isStdCell()) {
+      odb::dbInst* db_inst_ = cell->getDbInst();
+      // Only move the instance if necessary to avoid triggering callbacks.
+      if (db_inst_->getOrient() != cell->getOrient()) {
+        db_inst_->setOrient(cell->getOrient());
+      }
+      const DbuX x = core_.xMin() + cell->getLeft();
+      const DbuY y = core_.yMin() + cell->getBottom();
+      int inst_x, inst_y;
+      db_inst_->getLocation(inst_x, inst_y);
+      if (x != inst_x || y != inst_y) {
+        db_inst_->setLocation(x.v, y.v);
+      }
+    }
+  }
+}
+
+void Opendp::reportEvolvePlacementMetrics(const char* stage_name) const
+{
+  if (stage_name == nullptr || block_ == nullptr || network_ == nullptr) {
+    return;
+  }
+
+  const std::string prefix
+      = fmt::format("dpl_evolve__stage_{}__dp__", stage_name);
+
+  int cell_count = 0;
+  int movable_count = 0;
+  int placed_count = 0;
+  int moved_count = 0;
+  int64_t displacement_sum = 0;
+  int64_t displacement_max = 0;
+  for (const auto& cell : network_->getNodes()) {
+    if (cell->getType() != Node::CELL) {
+      continue;
+    }
+    ++cell_count;
+    if (cell->isFixed()) {
+      continue;
+    }
+
+    ++movable_count;
+    if (isPlaced(cell.get())) {
+      ++placed_count;
+    }
+
+    const int displacement = disp(cell.get());
+    displacement_sum += displacement;
+    displacement_max = std::max<int64_t>(displacement_max, displacement);
+    if (displacement > 0) {
+      ++moved_count;
+    }
+  }
+
+  const double avg_displacement
+      = movable_count == 0
+            ? 0.0
+            : static_cast<double>(displacement_sum)
+                  / static_cast<double>(movable_count);
+
+  logger_->metric(prefix + "cell_count", cell_count);
+  logger_->metric(prefix + "movable_count", movable_count);
+  logger_->metric(prefix + "placed_count", placed_count);
+  logger_->metric(prefix + "moved_count", moved_count);
+  logger_->metric(prefix + "total_displacement_micron",
+                  block_->dbuToMicrons(displacement_sum));
+  logger_->metric(prefix + "avg_displacement_micron",
+                  block_->dbuToMicrons(avg_displacement));
+  logger_->metric(prefix + "max_displacement_micron",
+                  block_->dbuToMicrons(displacement_max));
+  logger_->info(DPL,
+                1211,
+                "DPL-Evolve stage {} DP metrics: moved {}/{}, avg disp {:.3f} "
+                "u, max disp {:.3f} u.",
+                stage_name,
+                moved_count,
+                movable_count,
+                block_->dbuToMicrons(avg_displacement),
+                block_->dbuToMicrons(displacement_max));
+}
