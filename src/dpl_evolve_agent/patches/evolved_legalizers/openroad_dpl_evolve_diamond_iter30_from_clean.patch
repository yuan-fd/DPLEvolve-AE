+////////////////////////////////////////////////////////////////////////////////
+////////////////////////////////////////////////////////////////////////////////
+int DetailedMgr::getCellSpacing(const Node* ndl, const Node* ndr)
+{
+  if (ndl == nullptr || ndr == nullptr) {
+    return 0;
+  }
+  return arch_->getCellSpacing(ndl, ndl);
+}
