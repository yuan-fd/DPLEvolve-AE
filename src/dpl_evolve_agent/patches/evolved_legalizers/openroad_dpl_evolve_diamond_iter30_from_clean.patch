+            = binOverlapSites(site, gc.width_sites, bin, bin_sites, site_count);
+        if (overlap == 0) {
+          continue;
+        }
+        const double density
+            = static_cast<double>(
+                  current_occupancy[((row + dy) * bin_count) + bin])
+              * bin_inv_capacities[bin];
+        demand += static_cast<double>(overlap) * density;
+      }
+    }
