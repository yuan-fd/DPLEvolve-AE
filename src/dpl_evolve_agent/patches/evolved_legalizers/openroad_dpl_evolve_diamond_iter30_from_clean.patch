+    const int site = target_sites[cell_idx];
+    const int row = target_rows[cell_idx];
+    const int first_bin = std::clamp(site / bin_sites, 0, bin_count - 1);
+    const int last_bin
+        = std::clamp((std::max(site, site + gc.width_sites - 1)) / bin_sites,
