{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/CODA-Team/DPLEvolve/ae/schemas/result.schema.json",
  "title": "DPLEvolve Per-Case Result",
  "description": "Schema for a single case result within an experiment run.",
  "type": "object",
  "required": ["case_id", "baseline_line", "status", "final_hpwl_micron"],
  "properties": {
    "case_id": {
      "type": "string",
      "description": "Case identifier, e.g. aes_nangate45."
    },
    "platform": {
      "type": "string",
      "enum": ["nangate45", "asap7"]
    },
    "baseline_line": {
      "type": "string",
      "enum": ["openroad_dpl_flow", "openroad_dpl_negotiation", "evolve_default", "evolve_candidate"]
    },
    "status": {
      "type": "string",
      "enum": ["ok", "error", "timeout", "skipped"]
    },
    "exit_code": { "type": "integer" },
    "design_metrics": {
      "type": "object",
      "properties": {
        "instance_count": { "type": "integer" },
        "instance_area": { "type": "number" },
        "movable_instance_count": { "type": "integer" }
      }
    },
    "hpwl_stages": {
      "type": "object",
      "properties": {
        "global_micron": { "type": "number" },
        "legalized_micron": { "type": "number" },
        "improved_micron": { "type": "number" },
        "final_micron": { "type": "number" }
      }
    },
    "legality": {
      "type": "object",
      "properties": {
        "placement_violations": { "type": "string" },
        "placement_violation_count": { "type": "integer" },
        "check_report_status": {
          "type": "string",
          "enum": ["present", "absent", "error"]
        }
      }
    },
    "runtime": {
      "type": "object",
      "properties": {
        "total_seconds": { "type": "number" },
        "detail_place_seconds": { "type": "number" },
        "improve_place_seconds": { "type": "number" }
      }
    },
    "metadata": {
      "type": "object",
      "properties": {
        "openroad_commit": { "type": "string" },
        "openroad_binary_sha256": { "type": "string" },
        "flow_variant": { "type": "string" },
        "run_tag": { "type": "string" }
      }
    },
    "relative_to_baseline": {
      "type": "object",
      "description": "HPWL improvement relative to openroad_dpl_flow baseline.",
      "properties": {
        "baseline_hpwl": { "type": "number" },
        "improvement_pct": { "type": "number" },
        "reference_baseline_hpwl": { "type": "number" }
      }
    }
  }
}
