{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/CODA-Team/DPLEvolve/ae/schemas/run-manifest.schema.json",
  "title": "Artifact run manifest",
  "description": "Record written by scripts/agent/run_artifact.sh after one supported artifact run.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "artifact",
    "status",
    "exit_code",
    "started_at",
    "finished_at"
  ],
  "properties": {
    "artifact": {
      "type": "string",
      "enum": ["table4", "table5", "table6", "figures", "search", "ariane", "smoke"]
    },
    "status": {
      "type": "string",
      "enum": ["PASS", "FAIL"]
    },
    "exit_code": {
      "type": "integer",
      "minimum": 0,
      "maximum": 255
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "finished_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
