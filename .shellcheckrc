# ShellCheck configuration for DPLEvolve AE scripts.
# https://www.shellcheck.net/wiki/

# Enable optional checks
enable=all

# Disable specific rules that produce too many false positives
# SC1091: Not following sourced files (we source from sibling repos that might not exist)
disable=SC1091
# SC2034: Unused variables (many are used by sourced scripts)
disable=SC2034
# SC2154: Variable referenced but not assigned (set by sourced scripts)
disable=SC2154
# SC2155: Declare and assign separately (style preference)
disable=SC2155

# Source paths to follow (relative to repo root)
source-path=scripts/
